@{
    ViewData["Title"] = "Login - ASAPGetaway";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login - ASAPGetaway</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: linear-gradient(135deg, #E0F2FE, #DBEAFE);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }
        .login-box {
            background: white;
            padding: 50px;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(96,165,250,0.2);
            border: 2px solid #BFDBFE;
            width: 100%;
            max-width: 460px;
        }
        h1 { color: #1E40AF; text-align: center; font-size: 2em; margin-bottom: 8px; }
        .subtitle { text-align: center; color: #64748B; margin-bottom: 30px; }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; color: #374151; font-weight: 600; margin-bottom: 8px; }
        .form-group input {
            width: 100%; padding: 14px 18px;
            border: 2px solid #E2E8F0; border-radius: 12px;
            font-size: 1em; background: #F8FAFC;
            transition: border-color 0.3s;
        }
        .form-group input:focus { outline: none; border-color: #93C5FD; background: white; }
        .btn-login {
            width: 100%; padding: 16px;
            background: linear-gradient(135deg, #60A5FA, #3B82F6);
            border: none; border-radius: 12px;
            color: white; font-size: 1.1em; font-weight: 700;
            cursor: pointer; transition: all 0.3s;
        }
        .btn-login:hover { background: linear-gradient(135deg, #3B82F6, #2563EB); }
        .result {
            margin-top: 20px; padding: 15px;
            border-radius: 10px; text-align: center;
        }
        .result.success { background: #D1FAE5; border: 2px solid #6EE7B7; color: #065F46; }
        .result.fail { background: #FEE2E2; border: 2px solid #FCA5A5; color: #991B1B; }
        .query-display {
            margin-top: 15px; padding: 12px;
            background: #F1F5F9; border-radius: 8px;
            font-family: monospace; font-size: 0.8em;
            color: #475569; word-break: break-all;
            border-left: 4px solid #3B82F6;
        }
    </style>
</head>
<body>
<div class="login-box">
    <h1>✈️ ASAPGetaway</h1>
    <p class="subtitle">Welcome back! Please sign in.</p>

    <form method="post">
        <div class="form-group">
            <label>Email</label>
            <input type="text" name="username" placeholder="name@example.com" />
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" name="password" placeholder="Password" />
        </div>
        <button type="submit" class="btn-login">Log in</button>
    </form>

    @if (ViewBag.Error != null)
    {
        <div class="result fail">
            Invalid email or password.
        </div>
    }
    else if (ViewBag.Success == false)
    {
        <div class="result fail">
            Invalid email or password.
        </div>
    }
    <div style="text-align: center; margin-top: 20px; padding-top: 15px; border-top: 1px solid #E2E8F0;">
        <a href="/" style="color: #3B82F6; text-decoration: none; font-size: 0.9em;">Back</a>
    </div>
</div>
</body>
</html>