@{
    int bookingId = ViewBag.BookingId ?? 0;
    decimal totalAmount = ViewBag.TotalAmount ?? 0;
}

<style>
    .payment-container { max-width: 600px; margin: 40px auto; padding: 30px; }
    .payment-header { text-align: center; margin-bottom: 30px; color: #333; }
    .order-summary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 25px; border-radius: 12px; margin-bottom: 30px;
        color: white; box-shadow: 0 4px 15px rgba(102,126,234,0.4);
    }
    .order-summary h3 { margin: 0 0 15px 0; font-size: 24px; font-weight: 700; }
    .order-summary .total { font-size: 32px; font-weight: 700; margin-top: 15px; }
    .payment-form { background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    .payment-form h3 { margin: 0 0 25px 0; color: #333; font-size: 22px; }
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; margin-bottom: 8px; font-weight: 600; color: #555; font-size: 14px; }
    .form-group input {
        width: 100%; padding: 12px; border: 2px solid #e0e0e0;
        border-radius: 8px; font-size: 16px; box-sizing: border-box; transition: border-color 0.3s;
    }
    .form-group input:focus { outline: none; border-color: #667eea; }
    .form-row { display: flex; gap: 15px; }
    .form-row .form-group { flex: 1; }
    .btn-pay {
        width: 100%; padding: 15px; font-size: 18px; font-weight: 700;
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white; border: none; border-radius: 10px; cursor: pointer;
    }
    .error-message { background: #f8d7da; color: #721c24; padding: 15px; border-radius: 8px; margin-bottom: 20px; }
    .field-hint { font-size: 12px; color: #888; margin-top: 4px; }
</style>

<div class="payment-container">
    <h1 class="payment-header">💳 Secure Payment</h1>

    @if (ViewBag.Error != null)
    {
        <div class="error-message">❌ @ViewBag.Error</div>
    }

    <div class="order-summary">
        <h3>📋 Order Summary</h3>
        <p><strong>Booking ID:</strong> #@bookingId</p>
        <div class="total">💰 Total: $@totalAmount</div>
    </div>

    <div class="payment-form">
        <h3>💳 Payment Details</h3>

        <form method="post" action="/Payments/Pay">
            <input type="hidden" name="bookingId" value="@bookingId" />

            <div class="form-row">
                <div class="form-group">
                    <label>First Name</label>
                    <input type="text" name="firstName" required placeholder="Israeli"
                           pattern="[A-Za-z\u0590-\u05FF]{2,50}" />
                    <div class="field-hint">Letters only</div>
                </div>
                <div class="form-group">
                    <label>Last Name</label>
                    <input type="text" name="lastName" required placeholder="Israeli"
                    pattern="[A-Za-z\u0590-\u05FF][A-Za-z\u0590-\u05FF\- ]{1,49}" />
                    <div class="field-hint">Letters only</div>
                </div>
            </div>

            <div class="form-group">
                <label>ID Number</label>
                <input type="text" name="nationalId" required placeholder="123456789"
                       pattern="[0-9]{9}" maxlength="9" />
                <div class="field-hint">9 digits</div>
            </div>

            <div class="form-group">
                <label>💳 Card Number</label>
                <input type="text" name="cardNumber" required placeholder="1234 5567 8901 2345"
                       pattern="[0-9]{4} [0-9]{4} [0-9]{4} [0-9]{4}" maxlength="19"
                       oninput="formatCardNumber(this)" />
                <div class="field-hint">Format: 1234 5567 8901 2345</div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Valid Date</label>
                    <input type="text" name="validDate" required placeholder="12/32"
                           pattern="(0[1-9]|1[0-2])\/[0-9]{2}" maxlength="5"
                           oninput="formatExpiry(this)" />
                    <div class="field-hint">MM/YY</div>
                </div>
                <div class="form-group">
                    <label>CVC</label>
                    <input type="text" name="cvc" required placeholder="123"
                           pattern="[0-9]{3}" maxlength="3" />
                    <div class="field-hint">3 digits</div>
                </div>
            </div>

            <button type="submit" class="btn-pay">🔒 Pay $@totalAmount</button>
        </form>

        <div style="text-align:center; margin-top:20px;">
            <a href="/Trips" style="color:#6c757d;">← Back to Trips</a>
        </div>
    </div>
</div>

<script>
    function formatCardNumber(input) {
        let val = input.value.replace(/\D/g, '').substring(0, 16);
        input.value = val.replace(/(.{4})/g, '$1 ').trim();
    }
    function formatExpiry(input) {
        let val = input.value.replace(/\D/g, '').substring(0, 4);
        if (val.length >= 2) val = val.substring(0, 2) + '/' + val.substring(2);
        input.value = val;
    }
</script>