@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<style>
    body { background: linear-gradient(135deg, #E0F2FE, #DBEAFE) !important; min-height: 100vh; }
    .identity-container {
        max-width: 500px; margin: 60px auto; padding: 50px;
        background: white; border-radius: 20px;
        box-shadow: 0 10px 40px rgba(96,165,250,0.2);
        border: 2px solid #BFDBFE;
    }
    .identity-container h1 { color: #1E40AF; text-align: center; font-weight: 700; }
    .identity-container .btn-primary {
        width: 100%; padding: 14px;
        background: linear-gradient(135deg, #60A5FA, #3B82F6);
        border: none; border-radius: 12px; font-size: 1.1em; font-weight: 700; color: white;
    }
</style>

<div class="identity-container">
    <h1>🔑 Forgot Password?</h1>
    <p style="text-align:center; color:#64748B;">Enter your email and we'll send you a reset link.</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-floating mb-3">
            <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
            <label asp-for="Input.Email">Email</label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Send Reset Link</button>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }