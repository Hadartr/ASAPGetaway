@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<style>
    body { background: linear-gradient(135deg, #E0F2FE, #DBEAFE) !important; min-height: 100vh; }
    .identity-container {
        max-width: 500px; margin: 60px auto; padding: 50px;
        background: white; border-radius: 20px;
        box-shadow: 0 10px 40px rgba(96,165,250,0.2);
        border: 2px solid #BFDBFE;
    }
    .identity-container h1 { color: #1E40AF; text-align: center; font-weight: 700; }
    .form-control {
        padding: 14px 18px; border: 2px solid #E2E8F0;
        border-radius: 12px; font-size: 1em; width: 100%;
    }
    .btn-primary {
        width: 100%; padding: 14px;
        background: linear-gradient(135deg, #60A5FA, #3B82F6);
        border: none; border-radius: 12px; font-size: 1.1em; font-weight: 700; color: white;
    }
</style>

<div class="identity-container">
    <h1>🔒 Reset Password</h1>
    <p style="text-align:center; color:#64748B;">Enter your new password below.</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input asp-for="Input.Token" type="hidden" />
        <input asp-for="Input.Email" type="hidden" />

        <div class="mb-3">
            <label>New Password</label>
            <input asp-for="Input.Password" type="password" class="form-control" placeholder="New password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Confirm Password</label>
            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Reset Password</button>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }