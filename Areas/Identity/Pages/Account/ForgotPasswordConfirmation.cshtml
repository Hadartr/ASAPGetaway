@page
@{
    ViewData["Title"] = "Check Your Email";
}

<style>
    body { background: linear-gradient(135deg, #E0F2FE, #DBEAFE) !important; min-height: 100vh; }
    .identity-container {
        max-width: 500px; margin: 60px auto; padding: 50px;
        background: white; border-radius: 20px;
        box-shadow: 0 10px 40px rgba(96,165,250,0.2);
        border: 2px solid #BFDBFE; text-align: center;
    }
    .identity-container h1 { color: #1E40AF; font-weight: 700; }
    .btn-primary {
        padding: 12px 30px;
        background: linear-gradient(135deg, #60A5FA, #3B82F6);
        border: none; border-radius: 12px; font-size: 1em; font-weight: 700; color: white;
        text-decoration: none; display: inline-block; margin-top: 20px;
    }
</style>

<div class="identity-container">
    <h1>📧 Check Your Email</h1>
    <p style="color:#64748B; font-size:1.1em;">
        If this email exists in our system,<br/>
        a password reset link has been sent to your inbox.
    </p>
    <div style="background:#EFF6FF; border:2px solid #BFDBFE; border-radius:12px; padding:20px; margin-top:20px;">
        <p style="color:#1E40AF; font-weight:600;">🔐 Security Note:</p>
        <p style="color:#3B82F6; font-size:0.9em;">
            Your old password cannot be recovered.<br/>
            Passwords are stored encrypted using SHA-256.
        </p>
    </div>
    <a href="/Identity/Account/Login" class="btn-primary">Back to Login</a>
</div>